# Serve the static homepage at the subdomain root.
DirectoryIndex index.html

# These modules are optional on cPanel; unsupported directives are skipped.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml text/xml image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  # Revalidate the document so visitors receive current content and asset hashes.
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS/JS/SVG URLs carry a content hash; image and font hashes are in filenames.
  <FilesMatch "\.(?:css|js|svg|woff2|avif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:jpg|jpeg|png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.[a-f0-9]{12}\.jpg$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Consolidate old landing-page URLs at the canonical homepage.
RewriteRule ^site(?:/index\.html)?/?$ https://precioustega.suavedigitals.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://precioustega.suavedigitals.com/ [R=301,L]
